# Configuration partagee par deploy.sh et teardown.sh
# Toutes les valeurs peuvent etre surchargees par une variable d'environnement
# (ex. : AWS_REGION=eu-west-1 ./infra/deploy.sh)

# Region : variable d'environnement, sinon celle de "aws configure", sinon Francfort
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || true)}"
AWS_REGION="${AWS_REGION:-eu-central-1}"

PROJECT_NAME="${PROJECT_NAME:-comtrade-app}"

# Amazon ECR
ECR_REPO="${ECR_REPO:-$PROJECT_NAME}"

# Amazon ECS Express Mode
CLUSTER_NAME="${CLUSTER_NAME:-comtrade-cluster}"
SERVICE_NAME="${SERVICE_NAME:-$PROJECT_NAME}"
CONTAINER_PORT="${CONTAINER_PORT:-8501}"
HEALTH_CHECK_PATH="${HEALTH_CHECK_PATH:-/_stcore/health}"   # endpoint de sante de Streamlit
TASK_CPU="${TASK_CPU:-512}"          # 0.5 vCPU
TASK_MEMORY="${TASK_MEMORY:-1024}"   # 1 Go
MIN_TASKS="${MIN_TASKS:-1}"
MAX_TASKS="${MAX_TASKS:-1}"          # 1 seule tache : pas besoin de sticky sessions

# IAM
EXEC_ROLE_NAME="${EXEC_ROLE_NAME:-${PROJECT_NAME}-execution-role}"
INFRA_ROLE_NAME="${INFRA_ROLE_NAME:-${PROJECT_NAME}-infrastructure-role}"

# CloudWatch Logs
LOG_GROUP="${LOG_GROUP:-/ecs/${PROJECT_NAME}}"
LOG_RETENTION_DAYS="${LOG_RETENTION_DAYS:-7}"

# Reseau (optionnel). Vide = VPC par defaut, security group cree automatiquement.
# A renseigner plus tard pour placer l'app dans le VPC de DocumentDB.
# Format : IDs separes par des virgules, ex. SUBNETS="subnet-aaa,subnet-bbb"
SUBNETS="${SUBNETS:-}"
SECURITY_GROUPS="${SECURITY_GROUPS:-}"
