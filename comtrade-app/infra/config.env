# Configuration shared by deploy.sh and teardown.sh
# Every value can be overridden by an environment variable
# (e.g. AWS_REGION=eu-west-1 ./infra/deploy.sh)

# Region: environment variable, else the one from "aws configure", else US East 1
AWS_REGION="${AWS_REGION:-$(aws configure get region 2>/dev/null || true)}"
AWS_REGION="${AWS_REGION:-us-east-1}"

# Team naming template for all AWS resources: bdcs-g3-<name>
NAME_PREFIX="${NAME_PREFIX:-bdcs-g3}"
PROJECT_NAME="${PROJECT_NAME:-${NAME_PREFIX}-streamlit}"

# Amazon ECR
ECR_REPO="${ECR_REPO:-$PROJECT_NAME}"

# Amazon ECS Express Mode
CLUSTER_NAME="${CLUSTER_NAME:-${NAME_PREFIX}-cluster}"
SERVICE_NAME="${SERVICE_NAME:-$PROJECT_NAME}"
CONTAINER_PORT="${CONTAINER_PORT:-8501}"
HEALTH_CHECK_PATH="${HEALTH_CHECK_PATH:-/_stcore/health}"   # Streamlit health endpoint
TASK_CPU="${TASK_CPU:-512}"          # 0.5 vCPU
TASK_MEMORY="${TASK_MEMORY:-1024}"   # 1 GB
MIN_TASKS="${MIN_TASKS:-1}"
MAX_TASKS="${MAX_TASKS:-1}"          # single task: no need for sticky sessions

# IAM
EXEC_ROLE_NAME="${EXEC_ROLE_NAME:-${PROJECT_NAME}-execution-role}"
INFRA_ROLE_NAME="${INFRA_ROLE_NAME:-${PROJECT_NAME}-infrastructure-role}"

# CloudWatch Logs
LOG_GROUP="${LOG_GROUP:-/ecs/${PROJECT_NAME}}"
LOG_RETENTION_DAYS="${LOG_RETENTION_DAYS:-7}"

# Network: default VPC, which also hosts DocumentDB.
# Comma-separated subnet IDs. Keep every AZ: they must match the shared ALB.
VPC_ID="${VPC_ID:-vpc-07f1d9fb1fef102bf}"
SUBNETS="${SUBNETS:-subnet-0de2deba152b3da66,subnet-082245938bf53dc2d,subnet-053910c8b65c20a77,subnet-03d0b6c4e4454878c,subnet-0e57958b8f32d7c21,subnet-01295569ef090d5fb}"
APP_SG_NAME="${APP_SG_NAME:-${PROJECT_NAME}-sg}"

# Amazon DocumentDB. Never put the password here: this file is committed.
# deploy.sh stores it in Secrets Manager, under DOCDB_SECRET_NAME.
DOCDB_HOST="${DOCDB_HOST:-bdcs-g3-documentdb-cluster.cluster-c9ackrdwcwiz.us-east-1.docdb.amazonaws.com}"
DOCDB_USERNAME="${DOCDB_USERNAME:-clusteradmin}"
DOCDB_DATABASE="${DOCDB_DATABASE:-ingestion}"
DOCDB_COLLECTION="${DOCDB_COLLECTION:-products}"
DOCDB_SECRET_NAME="${DOCDB_SECRET_NAME:-${NAME_PREFIX}-documentdb-password}"
DOCDB_SG_ID="${DOCDB_SG_ID:-sg-0e403fd9e21cefbc8}"   # bdcs-g3-data-access
