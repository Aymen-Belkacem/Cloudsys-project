# DocumentDB Configuration
DOCDB_HOST=your-documentdb-cluster.cluster-xxx.us-east-1.docdb.amazonaws.com
DOCDB_USERNAME=your_username
DOCDB_PASSWORD=your_password
DOCDB_DATABASE=ingestion
DOCDB_COLLECTION=reports_metadata
DOCDB_TLS=true

# AWS Configuration
AWS_REGION=us-east-1
S3_BUCKET_REPORTS=bdcs-g3-reports-pdf
PDF_LAMBDA_NAME=bdcs-g3-lambda-pdf
BEDROCK_CHAT_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Lambda Configuration
TIMEOUT=60
MEMORY_SIZE=1024